{
  "name": "panelis-php/module",
  "description": "Monitor installed Panelis packages, including versions, dependencies, and module details",
  "keywords": [
    "panelis"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Yugo",
      "email": "dedy.yugo.purwanto@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/support": "^13.0",
    "filament/filament": "^5.0",
    "panelis-php/activity": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Panelis\\Module\\": "src/",
      "Panelis\\Module\\Database\\Factories\\": "database/factories/",
      "Panelis\\Module\\Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Panelis\\Module\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Panelis\\Module\\Providers\\ModuleServiceProvider"
      ]
    },
    "panelis": {
      "plugins": [
        "Panelis\\Module\\Plugins\\ModulePlugin"
      ],
      "permissions": {
        "module": "Panelis\\Module\\Panel\\Resources\\ModuleResource\\Enums\\ModulePermission"
      }
    }
  },
  "require-dev": {
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.4",
    "pestphp/pest-plugin-laravel": "^4.1"
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
